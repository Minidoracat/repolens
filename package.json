  "ct3aMetadata": {
    "initVersion": "7.38.1"
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "bcrypt",
      "esbuild"
    ]
  }
}