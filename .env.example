# RepoLens 環境變數

# 加密金鑰（必填）— 用於加密 DB 中的 API Key
# 生成方式：openssl rand -hex 32
ENCRYPTION_KEY=

# Node.js
NODE_ENV=production
PORT=3000

# 資料目錄（可選，預設 ./data）
# DATA_DIR=./data
# UPLOAD_DIR=./data/uploads
# REPOS_CACHE_DIR=./data/repos

# Session（可選）
# SESSION_COOKIE_NAME=repolens_session
# SESSION_MAX_AGE_SECONDS=2592000
