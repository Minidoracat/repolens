# RepoLens 環境變數

# 加密金鑰（必填）— 用於加密 DB 中的 API Key
# 生成方式：openssl rand -hex 32
ENCRYPTION_KEY=

# Node.js
NODE_ENV=production
PORT=3000
# HOST=0.0.0.0

# 開發模式允許的來源（逗號分隔，用於區網訪問）
# ALLOWED_DEV_ORIGINS=192.168.1.100

# 資料目錄（可選，預設 ./data）
# DATA_DIR=./data
# UPLOAD_DIR=./data/uploads
# REPOS_CACHE_DIR=./data/repos

# 日誌設定
# LOG_DIR=./data/logs
# LOG_LEVEL=info
# LOG_RETENTION_DAYS=7

# 忘記密碼時設為 true，重啟後會重置管理員，完成後移除此變數
# RESET_ADMIN=true

# Session（可選）
# SESSION_COOKIE_NAME=repolens_session
# SESSION_MAX_AGE_SECONDS=2592000
